# NOTE: you can now paste both keys into the app itself (gear icon, top
# right) instead of editing this file — see the Settings panel. Values set
# there take priority; anything below is just a fallback.

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Hugging Face access token (free tier), used for Stable Diffusion image generation.
# Get one at https://huggingface.co/settings/tokens
# If left blank, the app still runs end-to-end — it just falls back to a
# local placeholder image instead of a generated one.
HUGGINGFACE_API_TOKEN=your_huggingface_free_api_token_here

# Optional: override the Gemini model used for script generation.
# Defaults to "gemini-flash-latest" (Google's auto-updating free-tier alias).
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Flask server settings.
# PORT=5000
# FLASK_DEBUG=false
